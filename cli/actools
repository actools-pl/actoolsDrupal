#!/usr/bin/env bash
# Actools CLI v14.0
# INSTALL_DIR resolution: prefer ACTOOLS_HOME (written to /etc/environment by
# setup_cli at install time) so this file works verbatim when copied to
# /usr/local/bin/actools; fall back to self-location for in-repo execution
# (e.g. tests, ./cli/actools), where ../ correctly points at the repo root.
INSTALL_DIR="${ACTOOLS_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$INSTALL_DIR" 2>/dev/null || { echo "Actools not found at $INSTALL_DIR"; exit 1; }

# =============================================================================
# D.0 — Profile resolution
#
# Strip --profile / --profile=VALUE from $@ before the main case statement.
# Read ACTOOLS_PROFILE from actools.env if present, resolve via dispatch.sh.
#
# Note on CLI authority (P0-F — CLI Authority Consolidation):
#   cli/actools is the SINGLE canonical source for the CLI. The installer
#   (actools.sh setup_cli) installs the CLI by copying this file verbatim to
#   /usr/local/bin/actools — there is no longer a setup_cli heredoc that
#   re-emits a second CLI implementation. Edit the CLI here and only here.
#   See docs/architecture/cli-authority-contract.md (Option A).
# =============================================================================

_actools_cli_profile=""
_actools_cli_remaining_args=()

# Strip --profile=VALUE or --profile VALUE from $@
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile=*)
            _actools_cli_profile="${1#*=}"
            shift
            ;;
        --profile)
            _actools_cli_profile="${2:-}"
            shift 2
            ;;
        *)
            _actools_cli_remaining_args+=("$1")
            shift
            ;;
    esac
done

# Reconstruct positional args without --profile
set -- "${_actools_cli_remaining_args[@]+"${_actools_cli_remaining_args[@]}"}"

# Source actools.env if present — full source matches actools.sh pattern.
# Provides BASE_DOMAIN, DB_*, and other operational config to all commands.
_actools_env_profile=""
_actools_profile_source="default"
if [[ -f "${INSTALL_DIR}/actools.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${INSTALL_DIR}/actools.env" 2>/dev/null || true
    set +a
    _actools_env_profile="${ACTOOLS_PROFILE:-}"
fi

# Read backup user password from state.json (canonical source — actools.sh writes it at install).
# Matches the pattern at actools.sh:1188.
BACKUP_PASS=$(jq -r '.backup_user_pass // empty' "${INSTALL_DIR}/.actools-state.json" 2>/dev/null || echo "")

# Source dispatch.sh (provides resolver functions and actools::cli::resolve_profile).
# shellcheck source=/dev/null
source "${INSTALL_DIR}/installer/dispatch.sh" 2>/dev/null || true

# Resolve profile with fail-closed conflict handling (Decision 2).
if declare -f actools::cli::resolve_profile >/dev/null 2>&1; then
    if ! ACTOOLS_PROFILE="$(actools::cli::resolve_profile "$_actools_cli_profile" "$_actools_env_profile")"; then
        exit $?
    fi
    export ACTOOLS_PROFILE

    # Record how the profile was determined for doctor reporting.
    if [[ -n "$_actools_cli_profile" ]]; then
        _actools_profile_source="cli"
    elif [[ -n "$_actools_env_profile" ]]; then
        _actools_profile_source="env-file"
    fi
    export _actools_profile_source
fi

php_svc() { echo "php_${1:-prod}"; }

case "${1:-help}" in
  doctor)
    shift
    # shellcheck source=/dev/null
    source "${INSTALL_DIR}/cli/commands/doctor.sh"
    run_doctor "$@"
    exit $?
    ;;

  logs)
    shift
    [[ $# -gt 0 ]] && docker compose logs -f "$@" || docker compose logs -f
    ;;
  restart)    docker compose restart "${2:-}" ;;
  status)     docker compose ps ;;
  stats)      docker stats --no-trunc ;;

  worker-logs)   docker compose logs -f worker_prod ;;
  worker-status) docker compose exec worker_prod bash -c "cd /var/www/html/prod && ./vendor/bin/drush queue:list" ;;
  worker-run)
    echo "Running queue worker manually on prod..."
    docker compose exec worker_prod bash -c "cd /var/www/html/prod && ./vendor/bin/drush queue:run actools_document_export"
    ;;

  pdf-test)
    echo "=== XeLaTeX Test (inside worker container) ==="
    docker compose exec worker_prod xelatex --version 2>/dev/null       && echo "XeLaTeX: OK"       || echo "XeLaTeX: FAILED -- rebuild: docker build -t actools_worker:latest -f ~/Dockerfile.worker ~/"
    echo ""
    docker inspect actools_worker_prod --format='  Health: {{.State.Health.Status}}' 2>/dev/null || echo "  (container not running)"
    ;;

  storage-test)
    echo "=== S3 Storage Round-Trip Test ==="
    docker compose exec php_prod bash -c "
      cd /var/www/html/prod
      ./vendor/bin/drush php:eval \"
        \$test_content = 'actools-storage-test-' . time();
        \$uri = 's3://actools-roundtrip-test.txt';
        \$written = file_put_contents(\$uri, \$test_content);
        if (\$written === false) { echo 'WRITE FAILED'; exit(1); }
        echo 'WRITE OK (' . \$written . ' bytes)';
        \$read = file_get_contents(\$uri);
        echo \$read === \$test_content ? 'READ OK' : 'READ FAILED';
        \$deleted = unlink(\$uri);
        echo \$deleted ? 'DELETE OK' : 'DELETE FAILED';
        echo 'Round-trip: ' . (\$read === \$test_content && \$deleted ? 'PASS' : 'FAIL');
      \" 2>/dev/null || echo 'S3 stream test failed'
    " 2>/dev/null || echo "Could not connect to php_prod"
    ;;

  storage-info)
    ENV_FILE="${INSTALL_DIR}/actools.env"
    [[ -f "$ENV_FILE" ]] && { set -a; source "$ENV_FILE"; set +a; }
    STORAGE_PROVIDER="${STORAGE_PROVIDER:-${S3_PROVIDER:-aws}}"
    S3_ENDPOINT_URL="${S3_ENDPOINT_URL:-${S3_ENDPOINT:-}}"
    ASSET_CDN_HOST="${ASSET_CDN_HOST:-${CLOUDFLARE_CDN_DOMAIN:-}}"
    echo "=== S3 Storage Configuration ==="
    echo "Provider  : ${STORAGE_PROVIDER:-not set}"
    echo "Bucket    : ${S3_BUCKET:-not set}"
    case "${STORAGE_PROVIDER:-aws}" in
      aws)       echo "Region    : ${AWS_REGION:-not set}" ;;
      backblaze|wasabi|custom) echo "Endpoint  : ${S3_ENDPOINT_URL:-not set}" ;;
    esac
    [[ -n "${ASSET_CDN_HOST:-}" ]] && echo "CDN host  : ${ASSET_CDN_HOST}"
    echo "XeLaTeX mode: ${XELATEX_MODE:-local}"
    ;;

  dry-run)
    echo "=== DRY-RUN: Steps actools update will take ==="
    echo "(Static description — does not inspect current state)"
    echo "1. Pre-update snapshot of actools_prod"
    echo "2. docker compose pull"
    echo "3. docker compose up -d"
    echo "4. drush updb + cr per environment"
    echo "5. caddy reload"
    ;;

  update)
    echo "Taking pre-update prod snapshot..."
    SNAP="${INSTALL_DIR}/backups/pre_update_prod_$(date +%F_%H%M%S).sql.gz"
    [[ -z "$BACKUP_PASS" ]] && { echo "ERROR: backup_user_pass missing from .actools-state.json — reinstall or restore state to regenerate"; exit 1; }
    # Safe snapshot: pass the backup password via a temp defaults file created
    # INSIDE the db container (umask 077, trap-cleaned) so it never appears in
    # any host or container process argument list.
    printf '%s\n' '[mariadb-dump]' 'user=backup' "password=${BACKUP_PASS}" \
      | docker exec -i actools_db sh -c '
          umask 077; t=$(mktemp /tmp/actools-dump.XXXXXX.cnf); trap "rm -f \"$t\"" EXIT
          cat > "$t"
          mariadb-dump --defaults-extra-file="$t" "$@"
        ' _ --single-transaction --quick actools_prod \
      | gzip > "$SNAP" && echo "Snapshot: $SNAP" || echo "Snapshot failed (non-fatal)"
    docker compose pull db redis php_prod
    docker compose up -d
    for env in $(echo "${ENVIRONMENTS:-prod}" | tr ',' ' '); do
      svc=$(php_svc "$env")
      if docker compose ps "$svc" | grep -q "Up"; then
        echo "drush updb on ${env}..."
        docker compose exec -T "$svc" bash -c \
          "cd /var/www/html/${env} && ./vendor/bin/drush updb --yes && ./vendor/bin/drush cr" \
          2>&1 || {
            echo "ERROR: drush updb failed for ${env} — update aborted before caddy reload"
            echo "Pre-update snapshot retained at: ${SNAP}"
            echo "Manual rollback: actools restore prod ${SNAP}"
            exit 1
          }
      fi
    done
    docker exec actools_caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || true
    echo "Update complete."
    ;;

  backup)     /etc/cron.daily/actools-backup ;;

  health)
    for env in $(echo "${ENVIRONMENTS:-prod}" | tr ',' ' '); do
      dom="${env}.${BASE_DOMAIN}"
      [[ "$env" == "prod" ]] && dom="${BASE_DOMAIN}"
      http=$(curl -sso /dev/null -w "%{http_code}" --max-time 5 "https://$dom" 2>/dev/null || echo "ERR")
      hlth=$(curl -sso /dev/null -w "%{http_code}" --max-time 5 "https://$dom/health" 2>/dev/null || echo "ERR")
      echo "$dom: HTTP=$http  /health=$hlth"
    done
    ;;

  drush)
    env="${2:-prod}"
    svc=$(php_svc "$env")
    shift 2 2>/dev/null || shift 1 2>/dev/null || true
    docker compose exec "$svc" bash -c \
      'cd "$1" && ./vendor/bin/drush "${@:2}"' \
      _ "/var/www/html/${env}" "$@"
    ;;
  console)
    env="${2:-prod}"
    svc=$(php_svc "$env")
    docker compose exec "$svc" bash -c \
      'cd "$1" && ./vendor/bin/drush php:cli' \
      _ "/var/www/html/${env}"
    ;;
  shell)      docker compose exec "${2:-php_prod}" bash ;;

  restore-test)
    LATEST=$(ls -t "${INSTALL_DIR}/backups"/prod_db_*.sql.gz 2>/dev/null | head -1)
    [[ -z "$LATEST" ]] && { echo "No prod DB backups found"; exit 1; }
    echo "Testing DB restore: $LATEST"
    sha256sum -c "$LATEST.sha256" && echo "Checksum OK" || { echo "CHECKSUM FAILED"; exit 1; }
    docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$@"' _ -e \
      "CREATE DATABASE IF NOT EXISTS actools_restore_test CHARACTER SET utf8mb4;"
    gunzip -c "$LATEST" | docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$1"' _ actools_restore_test
    TC=$(docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$@"' _ -sN -e \
      "SELECT count(*) FROM information_schema.tables WHERE table_schema='actools_restore_test';")
    docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$@"' _ -e "DROP DATABASE IF EXISTS actools_restore_test;"
    echo "DB restore test OK -- ${TC} tables restored."
    date -Iseconds > "${INSTALL_DIR}/backups/.restore-test-last"
    ;;

  restore)
    env="${2:-prod}"
    db="actools_${env}"
    BACKUP_FILE="${3:-}"
    [[ -z "$BACKUP_FILE" ]] &&       BACKUP_FILE=$(ls -t "${INSTALL_DIR}/backups"/"${env}"_db_*.sql.gz "${INSTALL_DIR}/backups"/"${env}"_db_*.sql.gz.age 2>/dev/null | head -1)
    [[ -z "$BACKUP_FILE" ]] && { echo "No backups found for $env"; exit 1; }
    echo "Restoring $env from: $BACKUP_FILE"
    if [[ -f "$BACKUP_FILE.sha256" ]]; then
      sha256sum -c "$BACKUP_FILE.sha256" >/dev/null 2>&1 && echo "Checksum OK" \
        || { echo "CHECKSUM FAILED: $BACKUP_FILE -- aborting before any destructive action" >&2; exit 1; }
    else
      echo "WARNING: no checksum file for $BACKUP_FILE"
    fi
    if [[ "$BACKUP_FILE" == *.age && ! -f "${INSTALL_DIR}/.age-key.txt" ]]; then
      echo "ERROR: $BACKUP_FILE is encrypted but no Age private key at ${INSTALL_DIR}/.age-key.txt" >&2
      exit 1
    fi
    read -rp "OVERWRITE actools_${env}? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$@"' _ -e \
      "DROP DATABASE IF EXISTS \`${db}\`; CREATE DATABASE \`${db}\` CHARACTER SET utf8mb4;"
    if [[ "$BACKUP_FILE" == *.age ]]; then
      age --decrypt -i "${INSTALL_DIR}/.age-key.txt" "$BACKUP_FILE" | gunzip -c | docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$1"' _ "$db"
    else
      gunzip -c "$BACKUP_FILE" | docker exec -i actools_db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$1"' _ "$db"
    fi
    echo "Restore complete. Run: actools drush $env cr"
    ;;

  caddy-reload)
    docker exec actools_caddy caddy reload --config /etc/caddy/Caddyfile
    ;;

  tls-status)
    echo "=== TLS Certificate Status ==="
    for domain in "${BASE_DOMAIN}" "stg.${BASE_DOMAIN}" "dev.${BASE_DOMAIN}"; do
      echo -n "$domain: "
      echo | openssl s_client -connect "$domain:443" -servername "$domain" 2>/dev/null         | openssl x509 -noout -dates 2>/dev/null | grep notAfter | cut -d= -f2         || echo "not available yet"
    done
    ;;

  slow-log)
    env="${2:-prod}"
    svc=$(php_svc "$env")
    echo "=== PHP-FPM slow log for $env ==="
    docker compose exec "$svc" tail -50 /var/log/php/www-slow.log 2>/dev/null       || echo "No slow log yet"
    ;;

  redis-info) docker compose exec redis redis-cli info memory 2>/dev/null || echo "Redis not running" ;;
  oom)
    echo "=== Recent OOM Events ==="
    dmesg | grep -i "oom\|out of memory\|killed process" | tail -20 || echo "No OOM events"
    ;;

  migrate)
    echo "=== XeLaTeX Migration Guide ==="
    echo "Current mode: ${XELATEX_MODE:-local}"
    echo ""
    echo "1. Deploy XeLaTeX HTTP service on target server"
    echo "2. Set XELATEX_MODE=remote and XELATEX_ENDPOINT=http://<host>:8081 in actools.env"
    echo "3. Update PdfService.php to use HTTP when XELATEX_MODE=remote"
    echo "4. Rebuild worker image without texlive packages"
    echo "5. Verify: actools pdf-test"
    ;;

  log-dir)
    echo "=== Install Log Directory ==="
    LOG_DIR="/home/actools/logs/install"
    echo "Location: $LOG_DIR"
    ls -lht "$LOG_DIR" 2>/dev/null | head -20 || echo "No install logs found."
    echo "Main log: /home/actools/actools-install.log"
    LATEST=$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -1)
    [[ -n "$LATEST" ]] && echo "Latest run: tail -f $LATEST" || true
    ;;

  tunnel)
    case "${2:-status}" in
      status)  systemctl status cloudflared --no-pager ;;
      restart) sudo systemctl restart cloudflared && echo "cloudflared restarted" ;;
      logs)    journalctl -u cloudflared -n 50 --no-pager ;;
      *)       echo "Usage: actools tunnel [status|restart|logs]" ;;
    esac
    ;;

  audit)
    AUDIT_SCRIPT="${INSTALL_DIR}/modules/audit/audit.sh"
    [[ ! -f "$AUDIT_SCRIPT" ]] && { echo "audit module not found at $AUDIT_SCRIPT"; exit 1; }
    export ACTOOLS_HOME="${INSTALL_DIR}"
    # shellcheck source=/dev/null
    source "${INSTALL_DIR}/modules/audit/lib/output.sh" 2>/dev/null || true
    cd "${INSTALL_DIR}"
    set -a; source "${INSTALL_DIR}/actools.env" 2>/dev/null || true; set +a
    bash "$AUDIT_SCRIPT" "${@:2}"
    ;;
  help|*)
    if [[ "${2:-}" == "advanced" || "${2:-}" == "all" ]]; then
      cat <<'EOF'
Actools Drupal Community — Full Command Reference

Common
  doctor              Daily health check (site, TLS, DB, Redis, disk, backups)
  doctor --deep       Performance trends, drift, forecasting (in development)
  audit               Drupal health audit + scoring
  status              Container status
  logs [svc]          Stream logs
  backup              Run a backup now
  update              Pull + drush updb + caddy reload
  restart [svc]       Restart a service
  drush <env> <cmd>   Run drush in a container

Support
  restore <env> [f]   Restore with confirmation
  restore-test        Verify latest backup
  tls-status          TLS certificate expiry
  worker-status       Drupal queue status
  worker-logs         Worker container logs
  worker-run          Run queue worker manually
  pdf-test            XeLaTeX test inside worker
  slow-log [env]      PHP-FPM slow request log
  redis-info          Redis memory usage

Advanced
  migrate             XeLaTeX remote migration guide
  storage-test        S3 round-trip test
  storage-info        Storage + XeLaTeX config
  tunnel [sub]        Cloudflare tunnel (status|restart|logs)
  stats               Live Docker resource usage
  shell [svc]         Bash in container
  console <env>       Drush PHP console
  caddy-reload        Zero-downtime Caddy reload
  oom                 Recent OOM events
  log-dir             Install log directory
  dry-run             What 'update' would do
  health              HTTP + /health status (legacy; prefer 'doctor')

See:  docs/command-reference.md
EOF
    else
      cat <<'EOF'
Actools Drupal Community

Common commands:
  actools doctor       Daily health check
  actools audit        Drupal health audit + scoring
  actools status       Container status
  actools logs         Stream logs
  actools backup       Run a backup
  actools update       Update stack and run Drupal updates
  actools restart      Restart services
  actools drush        Run a Drush command

Support commands:
  actools restore-test
  actools restore
  actools tls-status
  actools worker-status

Advanced commands:
  actools help advanced

Daily docs:  docs/operator-handbook.md
EOF
    fi
    ;;
esac
